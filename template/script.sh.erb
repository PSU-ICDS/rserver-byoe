#!/bin/bash

# Load rstudio-server module
<%- require "socket" -%>
module use /storage/sys/<%= Socket.gethostname %>/modules
module load "${RSTUDIOSERVER:-rstudioserver}"

# Setup R version module or custom environment
<%- if context.environment_check == "custom" -%>
<%= context.custom_environment.gsub /\r\n?/, "\n" %>
<%- else -%>
<%- if context.texlive_load == "1" -%>
module load texlive
<%- end -%>
module load <%= context.auto_modules_r %>
<%- end -%>

# PAM auth helper used by RStudio
export RSTUDIO_AUTH="<%= session.staged_root.join("bin", "auth") %>"

# Generate an `rsession` wrapper script
export RSESSION_WRAPPER_FILE="<%= session.staged_root.join("rsession.sh") %>"

cat > "${RSESSION_WRAPPER_FILE}" <<'EOF'
#!/usr/bin/env bash
export RSESSION_LOG_FILE="<%= session.staged_root.join("rsession.log") %>"
exec &>>"${RSESSION_LOG_FILE}"

echo "Launching rsession..."
set -x
exec rsession "$@"
EOF

chmod +x "${RSESSION_WRAPPER_FILE}"

# Start RStudio Server
#

# Set working directory to home directory
cd "${HOME}"

# Create unique tmpdir
export TMPDIR="$(mktemp -d)"
mkdir ${TMPDIR}/rstudio
mkdir ${TMPDIR}/rstudio-server

# Create a new database.conf file to live in $TMPDIR
echo "directory=${TMPDIR}/rstudio" > $TMPDIR/rstudio/database.conf

# Output environment info to log
echo -e "\nmodule list:";module list
echo -e "\nwhich R:";which R
echo -e "\nR --version:";R --version

# Launch the RStudio Server
echo "Starting up rserver..."
set -x
rserver \
  --www-port ${port} \
  --auth-none 0 \
  --auth-pam-helper-path "${RSTUDIO_AUTH}" \
  --auth-encrypt-password 0 \
  --rsession-path "${RSESSION_WRAPPER_FILE}" \
  --server-data-dir "${TMPDIR}/rstudio" \
  --server-working-dir "${TMPDIR}/rstudio" \
  --server-user "${USER}" \
  --database-config-file "${TMPDIR}/rstudio/database.conf" \
  --auth-timeout-minutes 0 \
  --auth-stay-signed-in-days 30 \
  --secure-cookie-key-file "${TMPDIR}/rstudio-server/secure-cookie-key"
